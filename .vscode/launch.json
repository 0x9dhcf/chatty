{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug chatty (local deps)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/chatty",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "build: debug-local",
            "setupCommands": [
                { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "description": "Set Disassembly Flavor to Intel",  "text": "-gdb-set disassembly-flavor intel", "ignoreFailures": true }
            ]
        },
        {
            "name": "Debug chatty (remote deps)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/chatty",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "build: debug",
            "setupCommands": [
                { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "description": "Set Disassembly Flavor to Intel",  "text": "-gdb-set disassembly-flavor intel", "ignoreFailures": true }
            ]
        }
    ]
}
